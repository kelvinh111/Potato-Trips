// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanningSessionStatus {
  CLARIFYING
  READY_TO_GENERATE
  GENERATING
  GENERATED
  FAILED
}

enum PlanningSessionGenerationPhase {
  PREPARING_TRIP
  GENERATING_ITINERARY
  CHECKING_PLAN
  SAVING_ITINERARY
}

model PlanningSession {
  id                    String                @id @default(cuid())
  initialPrompt         String
  clarificationMessages Json                  @default("[]")
  planningBrief         Json?
  generatedItinerary    Json?
  generationPhase       PlanningSessionGenerationPhase?
  generationAttempts    Int                   @default(0)
  generationError       String?
  status                PlanningSessionStatus @default(CLARIFYING)
  expiresAt             DateTime
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([expiresAt])
}
